<!-- The colours of the light theme. The keys are the colour variables of tokens.css of the web version. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#f5f6f5" />
    <SolidColorBrush x:Key="Surface" Color="#ffffff" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#eceeec" />
    <SolidColorBrush x:Key="Border" Color="#d8dcd9" />
    <SolidColorBrush x:Key="Text" Color="#171a18" />
    <SolidColorBrush x:Key="TextMuted" Color="#5d6660" />
    <SolidColorBrush x:Key="Accent" Color="#166534" />
    <SolidColorBrush x:Key="AccentSoft" Color="#dcf3e3" />
    <SolidColorBrush x:Key="Danger" Color="#b3261e" />
    <SolidColorBrush x:Key="DangerSoft" Color="#fbe9e7" />
    <!-- Not a variable of tokens.css: the shade over the window behind a dialog, the backdrop of a dialog there. -->
    <SolidColorBrush x:Key="Backdrop" Color="#73000000" />
    <SolidColorBrush x:Key="CodeBg" Color="#eef0ee" />
    <SolidColorBrush x:Key="TokenComment" Color="#6f7772" />
    <SolidColorBrush x:Key="TokenString" Color="#2f6b3a" />
    <SolidColorBrush x:Key="TokenNumber" Color="#9a4d12" />
    <SolidColorBrush x:Key="TokenKeyword" Color="#7b3aa0" />
    <SolidColorBrush x:Key="Tag1Bg" Color="#dcf3e3" />
    <SolidColorBrush x:Key="Tag1Text" Color="#166534" />
    <SolidColorBrush x:Key="Tag2Bg" Color="#ebe5fb" />
    <SolidColorBrush x:Key="Tag2Text" Color="#5b21b6" />
    <SolidColorBrush x:Key="Tag3Bg" Color="#dfeafb" />
    <SolidColorBrush x:Key="Tag3Text" Color="#1e40af" />
    <SolidColorBrush x:Key="Tag4Bg" Color="#fbefcf" />
    <SolidColorBrush x:Key="Tag4Text" Color="#854d0e" />
    <SolidColorBrush x:Key="Tag5Bg" Color="#fbe3e8" />
    <SolidColorBrush x:Key="Tag5Text" Color="#9f1239" />
</ResourceDictionary>
