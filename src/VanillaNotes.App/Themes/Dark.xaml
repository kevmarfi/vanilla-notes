<!-- The colours of the dark theme. The keys are the colour variables of tokens.css of the web version. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0e1012" />
    <SolidColorBrush x:Key="Surface" Color="#14171a" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#1d2125" />
    <SolidColorBrush x:Key="Border" Color="#2a2f34" />
    <SolidColorBrush x:Key="Text" Color="#eceef0" />
    <SolidColorBrush x:Key="TextMuted" Color="#939ca4" />
    <SolidColorBrush x:Key="Accent" Color="#4ade80" />
    <SolidColorBrush x:Key="AccentSoft" Color="#14321f" />
    <SolidColorBrush x:Key="Danger" Color="#f08a80" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3a1f1d" />
    <!-- Not a variable of tokens.css: the shade over the window behind a dialog, the backdrop of a dialog there. -->
    <SolidColorBrush x:Key="Backdrop" Color="#73000000" />
    <SolidColorBrush x:Key="CodeBg" Color="#1d2125" />
    <SolidColorBrush x:Key="TokenComment" Color="#808990" />
    <SolidColorBrush x:Key="TokenString" Color="#9ccf8f" />
    <SolidColorBrush x:Key="TokenNumber" Color="#e0a86a" />
    <SolidColorBrush x:Key="TokenKeyword" Color="#c79be6" />
    <SolidColorBrush x:Key="Tag1Bg" Color="#14321f" />
    <SolidColorBrush x:Key="Tag1Text" Color="#86efac" />
    <SolidColorBrush x:Key="Tag2Bg" Color="#2a2140" />
    <SolidColorBrush x:Key="Tag2Text" Color="#c4b5fd" />
    <SolidColorBrush x:Key="Tag3Bg" Color="#172a45" />
    <SolidColorBrush x:Key="Tag3Text" Color="#93c5fd" />
    <SolidColorBrush x:Key="Tag4Bg" Color="#3a2a10" />
    <SolidColorBrush x:Key="Tag4Text" Color="#fcd34d" />
    <SolidColorBrush x:Key="Tag5Bg" Color="#40202a" />
    <SolidColorBrush x:Key="Tag5Text" Color="#fda4af" />
</ResourceDictionary>
