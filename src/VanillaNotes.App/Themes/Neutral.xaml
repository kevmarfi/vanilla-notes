<!-- The colours of the neutral theme, in warm paper tones. The keys are the colour variables of tokens.css of the web version. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#e8e4da" />
    <SolidColorBrush x:Key="Surface" Color="#f2efe7" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#dedace" />
    <SolidColorBrush x:Key="Border" Color="#c9c4b6" />
    <SolidColorBrush x:Key="Text" Color="#2a2822" />
    <SolidColorBrush x:Key="TextMuted" Color="#666256" />
    <SolidColorBrush x:Key="Accent" Color="#2f5d3a" />
    <SolidColorBrush x:Key="AccentSoft" Color="#cfdcc8" />
    <SolidColorBrush x:Key="Danger" Color="#9c3327" />
    <SolidColorBrush x:Key="DangerSoft" Color="#edd6cf" />
    <!-- Not a variable of tokens.css: the shade over the window behind a dialog, the backdrop of a dialog there. -->
    <SolidColorBrush x:Key="Backdrop" Color="#73000000" />
    <SolidColorBrush x:Key="CodeBg" Color="#dedace" />
    <SolidColorBrush x:Key="TokenComment" Color="#746f62" />
    <SolidColorBrush x:Key="TokenString" Color="#2f6b3a" />
    <SolidColorBrush x:Key="TokenNumber" Color="#9a4d12" />
    <SolidColorBrush x:Key="TokenKeyword" Color="#7b3aa0" />
    <SolidColorBrush x:Key="Tag1Bg" Color="#cfdcc8" />
    <SolidColorBrush x:Key="Tag1Text" Color="#2f5d3a" />
    <SolidColorBrush x:Key="Tag2Bg" Color="#dcd5e6" />
    <SolidColorBrush x:Key="Tag2Text" Color="#56348f" />
    <SolidColorBrush x:Key="Tag3Bg" Color="#d2dbe6" />
    <SolidColorBrush x:Key="Tag3Text" Color="#2a4a8a" />
    <SolidColorBrush x:Key="Tag4Bg" Color="#e8dbb8" />
    <SolidColorBrush x:Key="Tag4Text" Color="#7a4a10" />
    <SolidColorBrush x:Key="Tag5Bg" Color="#e8d0d0" />
    <SolidColorBrush x:Key="Tag5Text" Color="#8f2440" />
</ResourceDictionary>
