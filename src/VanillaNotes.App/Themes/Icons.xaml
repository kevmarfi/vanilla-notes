<!-- Line icons, drawn on a grid of 24 by 24 as the web version draws them (icons.js), and the one way to show one. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- An icon: a geometry of this dictionary as the content, drawn with the colour of the text around it. -->
    <Style x:Key="Icon" TargetType="ContentControl">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The smallest icon: the cross of a tag chip. -->
    <Style x:Key="IconXxs" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- A small icon in a row of the sidebar. -->
    <Style x:Key="IconXs" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!-- An icon of a button or a toolbar. -->
    <Style x:Key="IconSm" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- The leaf of the brand. -->
    <Style x:Key="IconLg" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- The icon of an empty area. -->
    <Style x:Key="IconXl" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>

