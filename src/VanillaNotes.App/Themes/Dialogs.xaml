<!-- What every dialog shares: a card that fits what it holds, in the middle of the window, over a shade that covers the page. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VanillaNotes.App.Controls">

    <!-- The card of a dialog: the size of what it holds, on the surface, as .dialog of the web version. -->
    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="MaxWidth" Value="640" />
    </Style>

    <!-- A dialog over the page: the shade over the whole window, and the card in its middle, kept away from the edges. -->
    <Style TargetType="controls:DialogLayer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Contained" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DialogLayer">
                    <Grid Background="{DynamicResource Backdrop}">
                        <Border Style="{StaticResource DialogCard}" Margin="{StaticResource DialogPageMargin}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The content of a dialog, with the room around it. -->
    <Style x:Key="DialogBody" TargetType="StackPanel">
        <Setter Property="Margin" Value="24" />
        <Setter Property="Width" Value="420" />
    </Style>

    <!-- The content of a dialog with a row of two actions side by side, wider so that they fit in both languages. -->
    <Style x:Key="WideDialogBody" TargetType="StackPanel" BasedOn="{StaticResource DialogBody}">
        <Setter Property="Width" Value="480" />
    </Style>

    <!-- The row of buttons at the foot of a dialog, to the right. -->
    <Style x:Key="DialogButtons" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <!-- The settings: wider than a dialog, and no taller than this, with a scroll when they do not fit, after settings-dialog.css of the web version. -->
    <Style x:Key="SettingsDialog" TargetType="UserControl">
        <Setter Property="MaxHeight" Value="720" />
    </Style>

    <!-- The content of the settings, with the room around it. -->
    <Style x:Key="SettingsBody" TargetType="StackPanel">
        <Setter Property="Margin" Value="24" />
        <Setter Property="Width" Value="560" />
    </Style>

    <!-- The heading of a group of settings, over a line. -->
    <Style x:Key="SettingsSection" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="Margin" Value="0,16,0,4" />
    </Style>

    <!-- A setting: its name on one side and its control on the other, with its explanation under both. -->
    <Style x:Key="SettingRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- A form of the profile, open under its row: the password, or deleting the profile. -->
    <Style x:Key="SettingsForm" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <!-- The explanation of a setting, under its row, with a line at its left. -->
    <Style x:Key="SettingHelp" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
</ResourceDictionary>
