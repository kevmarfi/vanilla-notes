<!-- The open note: the way of writing, the state of saving, and deleting; the title; the folder, the tags, and attaching a file; the attached files; and the text in the way chosen. A note in the trash is only read, with what puts it back or deletes it for good. -->
<UserControl x:Class="VanillaNotes.App.Views.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VanillaNotes.App.Controls"
        xmlns:vm="clr-namespace:VanillaNotes.App.ViewModels">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNote, Converter={StaticResource Hidden}}">
            <ContentControl Style="{StaticResource IconXl}" Content="{StaticResource IconNotes}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [editor.empty.pick.title], Source={StaticResource Texts}}" FontSize="{StaticResource TextLg}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{StaticResource EmptyTitleMargin}" />
            <TextBlock Text="{Binding [editor.empty.pick.text], Source={StaticResource Texts}}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Failure}" Style="{StaticResource ErrorText}" HorizontalAlignment="Center" Margin="{StaticResource GapAboveMd}" Visibility="{Binding HasFailure, Converter={StaticResource Visible}}" />
        </StackPanel>
        <DockPanel Margin="{StaticResource EditorMargin}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" controls:Dropping.FilesCommand="{Binding AttachFilesCommand}">
            <DockPanel DockPanel.Dock="Top" Margin="{StaticResource GapBelowSm}">
                <controls:TogglePicker DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource GapBelowSm}" Options="{Binding Modes}" SelectedKey="{Binding Mode}" ToolTip="{Binding [editor.modes], Source={StaticResource Texts}}" AutomationProperties.Name="{Binding [editor.modes], Source={StaticResource Texts}}"
                                       Visibility="{Binding IsWritable, Converter={StaticResource Visible}}" />
                <!-- The actions wrap onto a second line when the editor is too narrow to hold them on one. -->
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="{StaticResource ToolbarItemMargin}" TextWrapping="NoWrap" />
                    <Button Padding="{StaticResource ToolbarButtonPadding}" Margin="{StaticResource ToolbarItemMargin}" Command="{Binding PrintCommand}" AutomationProperties.Name="{Binding [editor.print], Source={StaticResource Texts}}"
                            ToolTip="{Binding [editor.print.help], Source={StaticResource Texts}}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource IconSm}" Content="{StaticResource IconPrinter}" Margin="{StaticResource GapRightSm}" />
                            <TextBlock Text="{Binding [editor.print], Source={StaticResource Texts}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="{StaticResource ToolbarItemMargin}" Command="{Binding TogglePinCommand}"
                            ToolTip="{Binding PinText}" AutomationProperties.Name="{Binding PinText}" Visibility="{Binding IsWritable, Converter={StaticResource Visible}}">
                        <ContentControl Style="{StaticResource IconSm}" Content="{StaticResource IconPin}" />
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Padding="{StaticResource ToolbarButtonPadding}" Margin="{StaticResource ToolbarItemMargin}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{Binding [editor.delete], Source={StaticResource Texts}}"
                            Visibility="{Binding IsWritable, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource IconSm}" Content="{StaticResource IconTrash}" Margin="{StaticResource GapRightSm}" />
                            <TextBlock Text="{Binding [editor.delete], Source={StaticResource Texts}}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="{StaticResource ToolbarButtonPadding}" Margin="{StaticResource ToolbarItemMargin}" Command="{Binding RestoreCommand}"
                            Content="{Binding [editor.restore], Source={StaticResource Texts}}" Visibility="{Binding IsInTrash, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource DangerButton}" Padding="{StaticResource ToolbarButtonPadding}" Margin="{StaticResource ToolbarItemMargin}" Command="{Binding DeleteForeverCommand}" AutomationProperties.Name="{Binding [editor.deleteForever], Source={StaticResource Texts}}"
                            Visibility="{Binding IsInTrash, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource IconSm}" Content="{StaticResource IconTrash}" Margin="{StaticResource GapRightSm}" />
                            <TextBlock Text="{Binding [editor.deleteForever], Source={StaticResource Texts}}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="{StaticResource GapBelowMd}" Visibility="{Binding IsInTrash, Converter={StaticResource Visible}}">
                <ContentControl DockPanel.Dock="Left" Style="{StaticResource IconSm}" Content="{StaticResource IconTrash}" Foreground="{DynamicResource TextMuted}" Margin="{StaticResource GapRightSm}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding TrashNotice}" Style="{StaticResource MutedText}" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Notice}" Background="{DynamicResource DangerSoft}" Margin="{StaticResource GapBelowMd}"
                    Visibility="{Binding HasFailure, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding [editor.loadLatest], Source={StaticResource Texts}}" Command="{Binding LoadLatestCommand}" Padding="{StaticResource ToolbarButtonPadding}"
                            Visibility="{Binding IsConflict, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Failure}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{StaticResource TextSm}" />
                </DockPanel>
            </Border>
            <TextBox DockPanel.Dock="Top" Style="{StaticResource BareTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{StaticResource TextXl}" FontWeight="SemiBold" Margin="{StaticResource GapBelowMd}" AutomationProperties.Name="{Binding [editor.title], Source={StaticResource Texts}}"
                     IsReadOnly="{Binding IsReading}" controls:FocusOnShow.Request="{Binding TitleFocusRequest}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoToTextCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <WrapPanel DockPanel.Dock="Top" Margin="{StaticResource GapBelowLg}" Orientation="Horizontal" IsEnabled="{Binding IsWritable}">
                <ContentControl Style="{StaticResource IconSm}" Content="{StaticResource IconFolder}" Foreground="{DynamicResource TextMuted}" Margin="{StaticResource GapRightSm}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedFolder}" MinWidth="{StaticResource FolderPickerMinWidth}" Margin="{StaticResource GapRightLg}"
                          AutomationProperties.Name="{Binding [editor.folder], Source={StaticResource Texts}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [editor.tags], Source={StaticResource Texts}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TagChip TagName="{Binding}" RemoveCommand="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid VerticalAlignment="Center">
                    <TextBox x:Name="TagBox" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" Padding="{StaticResource InlineBoxPadding}" MinWidth="{StaticResource TagBoxMinWidth}" FontSize="{StaticResource TextSm}"
                             AutomationProperties.Name="{Binding [editor.addTag], Source={StaticResource Texts}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding [editor.addTagPlaceholder], Source={StaticResource Texts}}" Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource TextSm}" Margin="{StaticResource TagPlaceholderMargin}" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text.Length, ElementName=TagBox, Converter={StaticResource VisibleWhenZero}}" />
                </Grid>
                <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource GapLeftSm}" VerticalAlignment="Center" Command="{Binding AttachCommand}" AutomationProperties.Name="{Binding [editor.attach], Source={StaticResource Texts}}"
                        Visibility="{Binding IsReading, Converter={StaticResource Hidden}}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconSm}" Content="{StaticResource IconPaperclip}" Margin="{StaticResource GapRightSm}" />
                        <TextBlock Text="{Binding [editor.attach], Source={StaticResource Texts}}" FontSize="{StaticResource TextSm}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Attachments}" Margin="{StaticResource GapBelowMd}" Focusable="False"
                          AutomationProperties.Name="{Binding [editor.attachments], Source={StaticResource Texts}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AttachmentChip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="{StaticResource AttachmentNameMaxWidth}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource TextXs}" Margin="{StaticResource AttachmentSizeMargin}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource AttachmentAction}" Content="{Binding [editor.attachment.insert], Source={StaticResource Texts}}"
                                        Command="{Binding DataContext.InsertImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsImage, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource AttachmentAction}" Content="{Binding [editor.attachment.save], Source={StaticResource Texts}}"
                                        Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource AttachmentAction}" Foreground="{DynamicResource Danger}" Content="{Binding [editor.attachment.delete], Source={StaticResource Texts}}"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.IsWritable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
                <controls:SourceEditor FocusRequest="{Binding TextFocusRequest}" Text="{Binding Content, Mode=TwoWay}" AskLink="{Binding AskLink}" PasteImage="{Binding PasteImage}" Spellcheck="{Binding Spellcheck}" ImageOf="{Binding ImageOf}" ImageToInsert="{Binding ImageToInsert}"
                                       Visibility="{Binding IsMarkdown, Converter={StaticResource Visible}}" />
                <controls:VisualEditor FocusRequest="{Binding TextFocusRequest}" Markdown="{Binding Content, Mode=TwoWay}" AskLink="{Binding AskLink}" PasteImage="{Binding PasteImage}" Spellcheck="{Binding Spellcheck}" ImageOf="{Binding ImageOf}" ImageToInsert="{Binding ImageToInsert}"
                                       IsVisualAllowed="{Binding IsVisualAllowed, Mode=OneWayToSource}"
                                       Visibility="{Binding IsVisual, Converter={StaticResource Visible}}" />
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="{StaticResource PanelPadding}"
                        Visibility="{Binding IsReading, Converter={StaticResource Visible}}">
                    <controls:MarkdownView Markdown="{Binding Content}" ImageOf="{Binding ImageOf}" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
