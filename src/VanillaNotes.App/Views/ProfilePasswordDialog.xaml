<!-- Opens a profile with Windows Hello or its password; when the password is forgotten, asks for a new one and Windows Hello or the recovery code. -->
<UserControl x:Class="VanillaNotes.App.Views.ProfilePasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VanillaNotes.App.Controls"
             xmlns:vm="clr-namespace:VanillaNotes.App.ViewModels">
    <StackPanel Style="{StaticResource DialogBody}">
        <StackPanel Visibility="{Binding IsAskingPassword, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="{StaticResource GapBelowLg}" />
            <Button Content="{Binding [password.hello], Source={StaticResource Texts}}" Command="{Binding OpenWithHelloCommand}" HorizontalAlignment="Left" Margin="{StaticResource GapBelowLg}"
                    Padding="{StaticResource SmallButtonPadding}" Visibility="{Binding CanUseHello, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding [login.password], Source={StaticResource Texts}}" Style="{StaticResource FieldLabel}" />
            <PasswordBox controls:PasswordBoxBinding.Password="{Binding Password}" />
            <Button Style="{StaticResource LinkButton}" Content="{Binding [login.forgotPassword], Source={StaticResource Texts}}" Command="{Binding ForgotCommand}" HorizontalAlignment="Left" Margin="{StaticResource GapAboveSm}" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsRecovering, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding RecoverHeading}" Style="{StaticResource Heading}" Margin="{StaticResource GapBelowSm}" />
            <TextBlock Text="{Binding [recover.hello.intro], Source={StaticResource Texts}}" Style="{StaticResource MutedText}" Margin="{StaticResource GapBelowLg}"
                       Visibility="{Binding IsRecoveringWithHello, Converter={StaticResource Visible}}" />
            <StackPanel Visibility="{Binding IsRecoveringWithCode, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding [recover.intro], Source={StaticResource Texts}}" Style="{StaticResource MutedText}" Margin="{StaticResource GapBelowLg}" />
                <TextBlock Text="{Binding [recover.code], Source={StaticResource Texts}}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" Margin="{StaticResource GapBelowMd}" />
            </StackPanel>
            <TextBlock Text="{Binding [login.reset.newPassword], Source={StaticResource Texts}}" Style="{StaticResource FieldLabel}" />
            <PasswordBox controls:PasswordBoxBinding.Password="{Binding NewPassword}" />
            <TextBlock Text="{Binding [login.passwordHint], Source={StaticResource Texts}}" Style="{StaticResource MutedText}" Margin="{StaticResource GapAboveXs}" />
            <Button Style="{StaticResource LinkButton}" Content="{Binding [recover.useCode], Source={StaticResource Texts}}" Command="{Binding UseCodeCommand}" HorizontalAlignment="Left" Margin="{StaticResource GapAboveSm}"
                    Visibility="{Binding IsRecoveringWithHello, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource LinkButton}" Content="{Binding [recover.useHello], Source={StaticResource Texts}}" Command="{Binding UseHelloCommand}" HorizontalAlignment="Left" Margin="{StaticResource GapAboveSm}"
                    Visibility="{Binding CanSwitchToHello, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource LinkButton}" Content="{Binding [recover.back], Source={StaticResource Texts}}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="{StaticResource GapAboveSm}" />
        </StackPanel>
        <TextBlock Text="{Binding Failure}" Style="{StaticResource ErrorText}" Margin="{StaticResource GapAboveMd}" Visibility="{Binding HasFailure, Converter={StaticResource Visible}}" />
        <StackPanel Style="{StaticResource DialogButtons}">
            <Button Content="{Binding [dialog.cancel], Source={StaticResource Texts}}" Command="{Binding CancelCommand}" IsCancel="True" Margin="{StaticResource GapRightSm}" />
            <Button Content="{Binding [password.submit], Source={StaticResource Texts}}" Command="{Binding OpenCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Visibility="{Binding IsAskingPassword, Converter={StaticResource Visible}}" />
            <Button Content="{Binding [recover.hello.submit], Source={StaticResource Texts}}" Command="{Binding ResetWithHelloCommand}" Style="{StaticResource PrimaryButton}"
                    Visibility="{Binding IsRecoveringWithHello, Converter={StaticResource Visible}}" />
            <Button Content="{Binding [recover.submit], Source={StaticResource Texts}}" Command="{Binding ResetCommand}" Style="{StaticResource PrimaryButton}"
                    Visibility="{Binding IsRecoveringWithCode, Converter={StaticResource Visible}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
